# ==============================================================================
# RISC-V RV32I Processor Core Makefile
# ==============================================================================

# ------------------------------------------------------------------------------
# Tools
# ------------------------------------------------------------------------------

SIMULATOR = iverilog
FLAGS     = -g2012

RISCV_AS = riscv64-elf-as
RISCV_LD = riscv64-elf-ld
OBJCOPY  = riscv64-elf-objcopy

# ------------------------------------------------------------------------------
# Directories / Files
# ------------------------------------------------------------------------------

RTL_SRCS = rtl/*.sv

ASM_DIR   = tests/asm
BIN_DIR   = tests/bin
HEX_DIR   = tests/hex
TOOLS_DIR = tests/tools
TB_DIR    = tb

SIM_OUT   = cpu_sim
WAVE_FILE = waves.vcd

# ------------------------------------------------------------------------------
# Phony targets
# ------------------------------------------------------------------------------

.PHONY: all compile run waves clean FORCE

all: test_riscv_core

# FORCE is used so `make test_X` always runs the simulation
FORCE:

# ------------------------------------------------------------------------------
# Default processor test
# ------------------------------------------------------------------------------

test_riscv_core: FORCE $(HEX_DIR)/test_riscv_core.hex
	$(SIMULATOR) $(FLAGS) \
		-o riscv_core_sim \
		$(RTL_SRCS) \
		$(TB_DIR)/tb_riscv_core.sv
	vvp riscv_core_sim

compile: $(RTL_SRCS) tb/tb_riscv_core.sv
	$(SIMULATOR) $(FLAGS) -o $(SIM_OUT) $(RTL_SRCS) tb/tb_riscv_core.sv

run: compile
	vvp $(SIM_OUT)

waves: run
	surfer $(WAVE_FILE) &

# ------------------------------------------------------------------------------
# Assembly → Object
# ------------------------------------------------------------------------------

$(BIN_DIR)/%.o: $(ASM_DIR)/%.asm
	$(RISCV_AS) -march=rv32i -mabi=ilp32 -o $@ $<

# ------------------------------------------------------------------------------
# Object → ELF
# ------------------------------------------------------------------------------

$(BIN_DIR)/%.elf: $(BIN_DIR)/%.o
	$(RISCV_LD) -m elf32lriscv -Ttext=0x0 -o $@ $<

# ------------------------------------------------------------------------------
# ELF → Binary
# ------------------------------------------------------------------------------

$(BIN_DIR)/%.bin: $(BIN_DIR)/%.elf
	$(OBJCOPY) -O binary $< $@

# ------------------------------------------------------------------------------
# Binary → Hex
# ------------------------------------------------------------------------------

$(HEX_DIR)/%.hex: $(BIN_DIR)/%.bin
	python3 $(TOOLS_DIR)/bin_to_hex.py $< $@

# ------------------------------------------------------------------------------
# Generic test target
#
# Example:
#   make test_alu
#   make test_imm
#
# This automatically:
#   test_alu → tests/hex/test_alu.hex → tb/tb_alu.sv
#   test_imm → tests/hex/test_imm.hex → tb/tb_imm.sv
# ------------------------------------------------------------------------------

test_%: FORCE $(HEX_DIR)/test_%.hex
	$(SIMULATOR) $(FLAGS) \
		-o $*_sim \
		$(RTL_SRCS) \
		$(TB_DIR)/tb_$*.sv
	vvp $*_sim

# ------------------------------------------------------------------------------
# Clean
# ------------------------------------------------------------------------------

clean:
	rm -f $(SIM_OUT)
	rm -f $(WAVE_FILE)
	rm -f *_sim
	rm -f $(BIN_DIR)/*.o
	rm -f $(BIN_DIR)/*.elf
	rm -f $(BIN_DIR)/*.bin
	rm -f $(HEX_DIR)/*.hex